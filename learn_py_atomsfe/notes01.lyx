\begin_layout Standard
where $
\backslash
widetilde{V}_{H}(r)/r$ is the Hartree potential and $V_{nuc}(r) = -Z/r$ is the Coulomb potential of the nucleus.
 For local and semilocal exchange-correlation functionals,
 namely LDA,
 GGA,
 and mGGA,
 the exchange-correlation energy takes the form:
\begin_inset Formula 
\[
E_{xc}^{{\rm LDA}}[\rho]=4\pi\int\rho(r)\,\varepsilon_{xc}^{{\rm LDA}}(\rho)\,r^{2}\,dr
\]

\end_inset


\begin_inset Formula 
\[
E_{xc}^{{\rm GGA}}[\rho,\nabla\rho]=4\pi\int\rho(r)\,\varepsilon_{xc}^{{\rm GGA}}(\rho,\nabla\rho)\,r^{2}\,dr
\]

\end_inset


\begin_inset Formula 
\[
E_{xc}^{{\rm mGGA}}[\rho,\nabla\rho,\tau]=4\pi\int\rho(r)\,\varepsilon_{xc}^{{\rm mGGA}}(\rho,\nabla\rho,\tau)\,r^{2}\,dr
\]

\end_inset

where $
\backslash
varepsilon_{xc}$ is the exchange-correlation energy per electron.
 For hybrid functionals,
 the correlation energy takes a local or semilocal form as above,
 while the exchange energy includes a fraction of the exact (Fock) exchange energy 
\backslash
cite{cinal2020highly,
 bhowmik2025spectral,
 trivedi2026spectral}:
\begin_inset Formula 
\[
E_{x}^{{\rm HF}}[\widetilde{R}_{nl}]=-\frac{1}{4}\sum_{\substack{nl\\
n'l'
}
}g_{nl}g_{n'l'}\sum_{l'\!'=|l-l'|}^{l+l'}\left[\begin{pmatrix}l & l' & l'\!'\\
0 & 0 & 0
\end{pmatrix}^{2}\iint\widetilde{R}_{nl}(r)\widetilde{R}_{n'l'}(r)\nu_{l'\!'}(r,r')\widetilde{R}_{nl}(r')\widetilde{R}_{n'l'}(r')\,drdr'\right]
\]

\end_inset

where
\begin_inset Formula 
\[
\begin{pmatrix}l & l' & l'\!'\\
0 & 0 & 0
\end{pmatrix}
\]

\end_inset

is the Wigner-3j symbol and 
\begin_inset Formula $\nu_{l'\!'}$
\end_inset

 is the radial Coulomb operator:
\begin_inset Formula 
\[
\nu_{l'\!'}(r,r')=\frac{r_{<}^{l'\!'}}{r_{>}^{l'\!'+1}}\,,\qquad r_{<}=\min(r,r')\,,\quad r_{>}=\max(r,r')
\]

\end_inset

The exact exchange energy can be equivalently written as:
\begin_inset Formula 
\[
E_{x}^{{\rm HF}}[\widetilde{R}_{nl}]=-\frac{1}{4}\sum_{\substack{nl\\
n'l'
}
}g_{nl}g_{n'l'}\sum_{l'\!'=|l-l'|}^{l+l'}\left[\begin{pmatrix}l & l' & l'\!'\\
0 & 0 & 0
\end{pmatrix}^{2}\int\widetilde{R}_{nl}(r)\frac{Y_{nln'l'}^{l'\!'}(r)}{r}\widetilde{R}_{n'l'}(r)\,dr\right]
\]

\end_inset

where 
\begin_inset Formula $Y_{nln'l'}^{l'\!'}(r)$
\end_inset

 satisfies the following differential equation 
\backslash
cite{fischerHFatoms,
 cinal2020highly}:
\begin_inset Formula 
\[
\Bigg[\frac{d^{2}}{dr^{2}}-\frac{l'\!'(l'\!'+1)}{r^{2}}\Bigg]Y_{nln'l'}^{l'\!'}(r)=-\frac{(2l'\!'+1)}{r}\widetilde{R}_{nl}(r)\widetilde{R}_{n'l'}(r)
\]

\end_inset


\begin_inset Formula 
\[
Y_{nln'l'}^{l'\!'}(r=0)=0,\quad\Bigg(\frac{dY_{nln'l'}^{l'\!'}(r)}{dr}+l'\!'\frac{Y_{nln'l'}^{l'\!'}(r)}{r}\Bigg)\Bigg\vert_{r\to\infty}=0
\]

\end_inset


\end_layout

\begin_layout Standard
In so doing,
 the application of the radial Coulomb operator is formulated as the solution of a differential equation.
 
\end_layout

